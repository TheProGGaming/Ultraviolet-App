# Copy to .env (or export in your shell). Never commit .env.
PORT=3100
HOST=127.0.0.1
BASE_URL=http://localhost:3100

# Meta app (developers.facebook.com) with Instagram Graph API / Facebook Login.
# Needed only for the "Connect with Facebook" button. You can instead paste a
# token + IG user id in Settings.
META_APP_ID=
META_APP_SECRET=
GRAPH_VERSION=v23.0
